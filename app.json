{
  "expo": {
    "name": "Shelfwise",
    "slug": "shelfwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shelfwise",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FBF8F3",
    "android": {
      "package": "com.shelfwise.expirytracker",
      "adaptiveIcon": {
        "backgroundColor": "#E2F4E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.shelfwise.expirytracker",
      "icon": "./assets/expo.icon",
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F3",
          "dark": {
            "backgroundColor": "#161513"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Shelfwise uses the camera to read expiry dates, scan barcodes and recognise products."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2E9E5B",
          "defaultChannel": "expiry-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Shelfwise can read an expiry date from a photo you already took."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
